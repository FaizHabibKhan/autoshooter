; Engine configuration file.
; Godot 4.x  —  Auto-Shooter prototype
; Input actions are registered at runtime in scripts/config.gd, so this file
; stays minimal and version-robust.

config_version=5

[application]

config/name="Auto Shooter"
config/description="Top-down auto-shooter with collectible allies."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/config.gd"
EventBus="*res://scripts/event_bus.gd"
GameManager="*res://scripts/game_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.066667, 0.078431, 0.109804, 1)
